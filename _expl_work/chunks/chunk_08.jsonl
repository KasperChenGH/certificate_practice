{"id": "finance_ethics-金融市場常識-270", "stem": "銀行將利率敏感性缺口控制在一適當水準，係用來管理下列何項風險？", "options": {"A": "營運風險", "B": "信用風險", "C": "市場風險", "D": "利率風險"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-271", "stem": "存款有一定時期之限制，存款人憑存單或依約定方式提取，並得以之質借之存款，稱為下列何者？", "options": {"A": "支票存款", "B": "活期存款", "C": "活期儲蓄存款", "D": "定期存款"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-272", "stem": "銀行兌付可轉讓定期存單、商業本票、國庫券之利息時，應按給付額多少百分比扣繳利息所得稅？", "options": {"A": "10%", "B": "15%", "C": "20%", "D": "30%"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-273", "stem": "依「洗錢防制法」之規定，金融機構對疑似洗錢之交易，應向下列何者申報？", "options": {"A": "財政部", "B": "法務部調查局", "C": "金融監督管理委員會", "D": "警察局"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-274", "stem": "提供下列何者予銀行辦理貸款者，不屬於擔保授信？", "options": {"A": "不動產抵押權", "B": "動產或權利質權", "C": "政府核准設立之信用保證機構保證", "D": "借款人開立之票據"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-275", "stem": "可轉讓定期存單以新台幣多少元為一單位，並按其倍數發行？", "options": {"A": "一萬元", "B": "五萬元", "C": "十萬元", "D": "五十萬元"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-276", "stem": "借款人提供房地產為擔保設定抵押權予銀行，其房屋應投保適當之保險，並以下列何者為受益人？", "options": {"A": "借款人", "B": "房地產所有權人", "C": "保證人", "D": "銀行"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-277", "stem": "有關銀行評估授信申請案件之主要考慮因素，下列何者有誤？", "options": {"A": "借款人之資信", "B": "借款資金用途", "C": "還款財源", "D": "介紹人之政治背景"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-278", "stem": "正常情況下，下列何種消費者貸款利率最低？", "options": {"A": "小額信用貸款", "B": "首次購屋貸款", "C": "汽車貸款", "D": "現金卡循環信用"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-279", "stem": "信用卡持卡人在繳款截止日前，繳足最低應繳金額，即可維持其良好信用紀錄，其餘由發卡銀行依未繳金額按月收取利息，此授信方式稱為下列何者？", "options": {"A": "小額信用貸款", "B": "循環信用", "C": "簡易貸款", "D": "資本支出貸款"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-280", "stem": "接受特約商店持簽帳單請款者稱為下列何者？", "options": {"A": "發卡銀行", "B": "信用卡客服中心", "C": "收單銀行", "D": "持卡人"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-281", "stem": "與卡片結合，提供消費者隨時透過自動提款機支借現金，以利救急使用之無擔保消費性貸款稱為下列何者？", "options": {"A": "現金卡", "B": "簽帳卡", "C": "認同卡", "D": "轉帳卡"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-282", "stem": "有關銀行發行信用卡之風險防範措施，下列敘述何者錯誤？", "options": {"A": "加強對申請人之徵信", "B": "研發信用卡之防偽技術", "C": "加強特約商店偽卡辨識訓練", "D": "將持卡人之個人及交易資料公開化"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-283", "stem": "經營外匯相關業務者，為處理國際間收付與國際清算之需要，進行不同貨幣間的相互交換之市場，稱為下列何者？", "options": {"A": "貨幣市場（Money Market）", "B": "資本市場（Capital Market）", "C": "外匯市場（Foreign Exchange Market）", "D": "權益市場（Equity Market）"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-284", "stem": "本國外匯市場係由不同型態的外匯交易參與者所組成，下列何者非屬其組織成員？", "options": {"A": "進出口商及旅行、投資者", "B": "外匯指定銀行", "C": "外匯經紀商", "D": "期貨交易所"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-285", "stem": "有關國際外匯市場之主要功能，下列敘述何者有誤？", "options": {"A": "提供國際匯兌與清算", "B": "擴大國際間各種貨幣之利差", "C": "提高國際資金運用效率", "D": "提供規避匯率風險的工具"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-286", "stem": "外匯交易雙方在一特定時點簽訂契約，決定匯率，並於交易後第二個營業日完成契約金額的交割，稱為下列何者？", "options": {"A": "即期交易", "B": "遠期交易", "C": "期貨交易", "D": "選擇權交易"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-287", "stem": "交易雙方在某特定時點決定匯率，並同意在未來某一時日交割的外匯交易市場，稱為下列何者？", "options": {"A": "即期外匯市場", "B": "遠期外匯市場", "C": "外匯期貨市場", "D": "國際資本市場"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-288", "stem": "當任何兩種通貨無直接兌換比率，必須透過第三種通貨間接計算而得的兌換率，稱為下列何者？", "options": {"A": "名目匯率", "B": "實質匯率", "C": "交叉匯率", "D": "均衡匯率"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-289", "stem": "遠期匯率與即期匯率的差額，稱為下列何者？", "options": {"A": "實質匯率", "B": "換匯匯率", "C": "交叉匯率", "D": "均衡匯率"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-290", "stem": "中央銀行為緩和本國通貨匯價的急遽升貶，可利用下列何種方式調節外匯供需，使達成適當匯率水準？", "options": {"A": "重貼現政策", "B": "準備金政策", "C": "選擇性信用管制", "D": "外匯干預"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-291", "stem": "外匯市場上，報價銀行EUR/USD 之報價為 1.1713/17，表示詢價者買入一歐元之價格為何？", "options": {"A": "1.1713 美元", "B": "1.1717 美元", "C": "1.1700 美元", "D": "0.8534 美元"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-292", "stem": "外資匯入美元，投資臺灣股市，唯恐將來匯出時新台幣貶值，可如何規避匯率風險？", "options": {"A": "買無本金交割遠期美元（NDF）", "B": "買入即期美元", "C": "買入美元賣權", "D": "賣出美元買權"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-293", "stem": "依中央銀行規定，下列何者非屬銀行應提存準備金之存款範圍?", "options": {"A": "支票存款", "B": "儲蓄存款", "C": "公教人員退休金存款", "D": "定期存款"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-294", "stem": "下列何者非屬主管機關對於金融機構流動性風險之規範？", "options": {"A": "法定準備金", "B": "最低流動比率", "C": "存放比率", "D": "資本適足率"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-295", "stem": "銀行承辦授信業務之基本原則，下列何者非屬之？", "options": {"A": "公開性", "B": "安全性", "C": "流動性", "D": "收益性"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-296", "stem": "在其他條件不變下，下列何者會使本國貨幣貶值？", "options": {"A": "本國利率上升", "B": "本國進口關稅下降", "C": "本國相對物價下跌", "D": "本國相對生產力提高"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-297", "stem": "下列何者非屬資訊安全的基本三要素？", "options": {"A": "一致性(Consistency)", "B": "完整性(Integrity)", "C": "可用性(Availability)", "D": "機密性(Confidentiality)"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-298", "stem": "下列何者非屬組織採用雲端運算服務的常見考量原因？", "options": {"A": "商譽", "B": "成本", "C": "速度", "D": "效能"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-299", "stem": "下列何種數據資料單位代表1024GB？", "options": {"A": "1ZB", "B": "1EB", "C": "1PB", "D": "1TB"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-300", "stem": "下列哪一個名詞和其他三個名詞不同義？", "options": {"A": "數據資料", "B": "大數據", "C": "巨量資料", "D": "海量資料"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-301", "stem": "下列何者非屬網際網路興起後的數位商品或服務模式？", "options": {"A": "純網路銀行", "B": "電子資金轉帳", "C": "電子商務支付系統", "D": "加密貨幣"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-302", "stem": "機器人是人工智慧的容器，若機器人是身體，而人工智慧可以比喻成機器人的哪一部分？", "options": {"A": "心臟", "B": "腳", "C": "手", "D": "大腦"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-303", "stem": "當保險業欲透過網路與電話語音等通路提供服務時，可運用何項技術驗證身分？", "options": {"A": "生物辨識", "B": "通訊技術", "C": "物聯網技術", "D": "網路技術"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-304", "stem": "下列何項敘述非屬純網路銀行的明顯獨特特色？", "options": {"A": "沒有實體分行", "B": "沒有實體ATM 機器", "C": "營業時間無限制全年無休", "D": "透過APP 提供金融服務"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-305", "stem": "下列何者非屬我國核准設立之純網路銀行？", "options": {"A": "連線銀行", "B": "將來銀行", "C": "新網銀行", "D": "樂天銀行"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-306", "stem": "目前各國金融監理機關對比特幣抱持戒慎恐懼的態度，考量的原因包含下列哪幾項？A.洗錢 B.資恐 C.逃稅 D.詐騙", "options": {"A": "僅A", "B": "僅A、B", "C": "僅A、B、C", "D": "A、B、C、D"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-307", "stem": "依信託法之規定，信託依設立方式之不同分為三種，下列何者非屬之？", "options": {"A": "契約信託", "B": "遺囑信託", "C": "宣言信託", "D": "法定信託"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-308", "stem": "委託人將財產權移轉予受託人，使依委託人意旨，為受益人利益管理或處分財產之法律關係為下列何者？", "options": {"A": "委任", "B": "信託", "C": "寄託", "D": "讓與擔保"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-309", "stem": "信託關係之委託人，須將其信託財產權主體變更為下列何者之名義？", "options": {"A": "受益人", "B": "受託人", "C": "信託監察人", "D": "第二受益人"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-310", "stem": "委託人將其船舶信託移轉予受託人，使依委託人意旨管理或處分，稱為下列何種信託？", "options": {"A": "動產信託", "B": "不動產信託", "C": "金錢信託", "D": "權利信託"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-311", "stem": "委託人將其土地信託移轉予受託人，使依委託人意旨管理或處分，稱之為下列何種信託？", "options": {"A": "不動產信託", "B": "動產信託", "C": "地上權信託", "D": "租賃權信託"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-312", "stem": "「以給付一定數額之金錢為標的」之債權信託，稱之為下列何種信託？", "options": {"A": "金錢信託", "B": "金錢債權信託", "C": "動產信託", "D": "不動產信託"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-313", "stem": "委託人將股票信託移轉予受託人管理，稱為下列何種信託？", "options": {"A": "金錢信託", "B": "金錢債權信託", "C": "有價證券信託", "D": "動產信託"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-314", "stem": "下列何者得擔任信託財產之受託人？", "options": {"A": "未成年人", "B": "受監護或輔助宣告之人", "C": "破產人", "D": "經主管機關許可經營信託業務之公司"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-315", "stem": "有關受託人對受益人之責任，下列敘述何者正確？", "options": {"A": "得承諾擔保本金", "B": "得擔保最低收益率", "C": "不得承諾擔保本金或最低收益率", "D": "僅得對大戶承諾擔保本金"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-316", "stem": "受託人處理信託事務，下列敘述何者錯誤？", "options": {"A": "應依信託本旨處理", "B": "應以善良管理人之注意處理", "C": "自有財產得與信託財產合併管理", "D": "受託人管理不當致信託財產發生損害時應予賠償"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-317", "stem": "下列何種制度係以自己為財產名義權利人，為他人利益管理財產？", "options": {"A": "信託", "B": "寄託", "C": "委任", "D": "代理"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-318", "stem": "有關委任與信託之敘述，下列何者錯誤？", "options": {"A": "信託關係之委託人須將財產權移轉給受託人", "B": "委任關係之委任人無須將財產權移轉給受任人", "C": "委任人管理或處分受任財產之效果歸屬於受任人", "D": "委任人並不因委任關係之成立而喪失其管理或處分財產之權限"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-319", "stem": "委託人以其享有之租賃權為信託標的，將之移轉與受託人管理使用，稱之為下列何種信託？", "options": {"A": "租賃權信託", "B": "地上權信託", "C": "專利權信託", "D": "金錢信託"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-320", "stem": "有關信託財產之敘述，下列何者錯誤？", "options": {"A": "受託人死亡時信託財產不屬於其遺產", "B": "受託人破產時信託財產不屬於其破產財團", "C": "受託人關於信託財產之占有，承繼委託人占有之瑕疵", "D": "屬於信託財產之債權與不屬於信託財產之債務得互相抵銷"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-321", "stem": "信託關係消滅時，除信託行為另有訂定外，有關信託財產之歸屬，下列何者為第一順位？", "options": {"A": "國庫", "B": "受託人", "C": "目的事業主管機關", "D": "享有全部信託利益之受益人"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-322", "stem": "有價證券中之股票及公司債券，除須依目的事業主管機關規定，於證券上載明其為信託財產外，尚須通知下列何者，始得對抗該公司？", "options": {"A": "證券期貨商", "B": "證券交易所", "C": "發行公司", "D": "經濟部"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-323", "stem": "依信託法規定，公益信託之監督機關為下列何者？", "options": {"A": "金融監督管理委員會", "B": "目的事業主管機關", "C": "法院", "D": "財政部"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-324", "stem": "下列何者不屬於信託業法規定信託業得經營之信託業務？", "options": {"A": "金錢信託", "B": "不動產信託", "C": "專利權信託", "D": "商譽信託"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-325", "stem": "主管機關基於風險考量，依信託業法規定，信託業辦理委託人不指定營運範圍或方法之金錢信託，其營運範圍下列何者非屬之？", "options": {"A": "現金", "B": "銀行存款", "C": "短期票券", "D": "上市股票"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-326", "stem": "依信託業法規定，信託業得經營之業務項目，下列何者非屬之？", "options": {"A": "著作權信託", "B": "人格權信託", "C": "專利權信託", "D": "有價證券信託"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-327", "stem": "依信託業法規定，營業信託契約之訂定，應以何種方式為之？", "options": {"A": "書面", "B": "口頭", "C": "電話", "D": "錄音"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-328", "stem": "下列哪一種契約信託，可以口頭為之或書面為之？", "options": {"A": "民事信託", "B": "金錢信託", "C": "有價證券信託", "D": "不動產信託"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-329", "stem": "下列何者非屬金融資產證券化條例所指之資產？", "options": {"A": "汽車貸款債權", "B": "房屋貸款債權", "C": "信用卡債權", "D": "不動產"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-330", "stem": "有關金融資產證券化之特性，下列何者錯誤？", "options": {"A": "由創始機構發行有價證券", "B": "現金流量可委由服務機構代為管理", "C": "金融資產證券化得採信用增強機制", "D": "所受讓特定金融資產為信用評等之基礎"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-331", "stem": "有關金融資產證券化之創始機構將金融資產移轉予特殊目的機構之會計項目，下列何者正確？", "options": {"A": "出售資產", "B": "借入款項", "C": "同業往來", "D": "票據貼現"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-332", "stem": "依金融資產證券化條例之規定，受益人會議係由下列何者召集之？", "options": {"A": "創始機構或受託機構", "B": "受託機構或信託監察人", "C": "服務機構或信託監察人", "D": "監督機構或服務機構"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-333", "stem": "依不動產證券化條例規定，所稱不動產管理機構，下列何者非屬之？", "options": {"A": "不動產投資業", "B": "營造業", "C": "信託業", "D": "建築經理業"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-334", "stem": "依信託法規定，信託行為有害於委託人之債權人權利者，債權人應如何主張權利？", "options": {"A": "向受託人主張信託契約無效", "B": "聲請法院撤銷信託行為", "C": "聲請召開債權人會議", "D": "聲請強制執行信託財產"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-335", "stem": "依信託法規定，有關信託關係消滅原因，下列何者正確？", "options": {"A": "委託人死亡", "B": "受託人破產", "C": "信託目的不能完成", "D": "委託人喪失行為能力"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-336", "stem": "依信託法及信託業法相關規定，信託業應負之義務，下列何者錯誤？", "options": {"A": "忠實義務", "B": "分別管理義務", "C": "保證收益義務", "D": "善良管理人注意義務"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-337", "stem": "依信託業法規定，有關信託業之利害關係人，下列何者錯誤？", "options": {"A": "擔任信託業之負責人", "B": "持有信託業資本總額5%以上者", "C": "對信託財產具有運用決定權者", "D": "擔任信託業定型化契約之審定人員"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-338", "stem": "運用一年期以內短期信用工具，調節短期資金供需的交易市場，稱為下列何者？", "options": {"A": "債券市場", "B": "貨幣市場", "C": "股票市場", "D": "期貨市場"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-339", "stem": "金融機構間之新台幣拆款市場，係屬下列何者？", "options": {"A": "債券市場", "B": "貨幣市場", "C": "股票市場", "D": "外匯市場"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-340", "stem": "下列何者非屬短期票券市場之信用工具？", "options": {"A": "國庫券", "B": "可轉讓定存單", "C": "匯票", "D": "公司債"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-341", "stem": "下列何者係在貨幣市場上擔任市場監督信用管理者及市場資金最後調節者？", "options": {"A": "票券商", "B": "商業銀行", "C": "中央銀行", "D": "財政部"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-342", "stem": "下列何者非屬貨幣市場的功能？", "options": {"A": "配合中央銀行執行貨幣政策", "B": "提供法人及個人理財工具", "C": "提供股票買賣的機制", "D": "建立利率指標"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-343", "stem": "中央政府為調節國庫收支，得發行未滿一年之信用工具，下列何者係屬之？", "options": {"A": "政府公債", "B": "建設公債", "C": "國庫券", "D": "金融債券"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-344", "stem": "銀行為了提高流動性，發行一種具有可轉讓但不可中途解約特性，並承諾一定時間後之到期日按票載利率支付本息予存款人之短期信用工具，係屬下列何者？", "options": {"A": "定期存單", "B": "可轉讓定期存單", "C": "金融債券", "D": "商業承兌匯票"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-345", "stem": "發票人簽發一定之金額，委託付款人於指定之到期日，無條件支付與受款人或執票人之票據，稱之為下列何者？", "options": {"A": "匯票", "B": "本票", "C": "支票", "D": "保付支票"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-346", "stem": "凡出售商品或提供勞務之相對人簽發之匯票，委託銀行為付款人而經其承兌者，稱之為下列何者？", "options": {"A": "銀行承兌匯票", "B": "商業承兌匯票", "C": "交易性商業本票", "D": "融資性商業本票"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-347", "stem": "凡出售商品或提供勞務之相對人簽發之匯票，以相對人(非銀行)為付款人而經其承兌者，稱之為下列何者？", "options": {"A": "銀行承兌匯票", "B": "商業承兌匯票", "C": "交易性商業本票", "D": "融資性商業本票"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-348", "stem": "發票人簽發一定之金額，於指定之到期日，由自己無條件支付與受款人或執票人之票據，稱之為下列何者？", "options": {"A": "匯票", "B": "本票", "C": "支票", "D": "承兌匯票"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-349", "stem": "下列何者非屬因出售商品或勞務之交易行為所簽發之票據？", "options": {"A": "銀行承兌匯票", "B": "商業承兌匯票", "C": "交易性商業本票", "D": "融資性商業本票"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-350", "stem": "下列貨幣市場的短期信用工具中，何者簡稱為RP？", "options": {"A": "附買回協議", "B": "附賣回協議", "C": "可轉讓定存單", "D": "國庫券"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-351", "stem": "下列何者為間接金融？", "options": {"A": "發行股票", "B": "發行短期票券", "C": "發行公司債", "D": "向銀行借款"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-352", "stem": "短期票券集中保管結算機構應以幾家為限？", "options": {"A": "一家", "B": "二家", "C": "三家", "D": "四家"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-353", "stem": "票券交割作業中，有關買賣雙方款項部分的清算作業，係由下列何者負責？", "options": {"A": "臺灣銀行", "B": "財金資訊網路", "C": "央行同資系統", "D": "聯徵中心"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-354", "stem": "下列何者為票券次級市場之交割方式？", "options": {"A": "無實體化", "B": "實體化", "C": "無實體化與實體化", "D": "人工作業"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-355", "stem": "下列何者為票券集中保管之結算交割方式？", "options": {"A": "款券同步交割", "B": "款先券後交割", "C": "券先款後交割", "D": "與券商協議而定"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-356", "stem": "下列何者之利息所得非採分離課稅方式扣繳，須依規定將利息所得併入綜合所得總額申報所得稅？", "options": {"A": "國庫券", "B": "可轉讓定存單", "C": "銀行承兌匯票", "D": "活期存款"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-357", "stem": "目前短期票券之利息所得採分離課稅，按給付額扣繳多少？", "options": {"A": "百分之十", "B": "百分之二十", "C": "百分之二十五", "D": "百分之三十"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-358", "stem": "投資人購買一張可轉讓定存單，假設其利息所得為十萬元，請問採分離課稅後，其實際淨利息所得為多少？", "options": {"A": "七萬元", "B": "七萬五仟元", "C": "八萬元", "D": "九萬元"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-359", "stem": "下列何種信用工具之承銷價格非採貼現方式計算？", "options": {"A": "國庫券", "B": "商業本票", "C": "銀行承兌匯票", "D": "可轉讓定存單"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-360", "stem": "票券商接受發行人之委託，依約定包銷或代銷票券之行為，稱為下列何者？", "options": {"A": "保證", "B": "簽證", "C": "承銷", "D": "標售"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-361", "stem": "下列何者亦稱為初級市場？", "options": {"A": "發行市場", "B": "流通市場", "C": "期貨市場", "D": "拆款市場"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-362", "stem": "下列何者非屬我國貨幣市場流通之主要信用工具？", "options": {"A": "可轉讓定存單", "B": "國庫券", "C": "商業本票", "D": "股票"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-363", "stem": "下列哪一種固定收益的信用工具，其信用風險最大？", "options": {"A": "政府公債", "B": "商業本票", "C": "垃圾債券", "D": "國庫券"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-364", "stem": "在貨幣市場上，我們常聽到「利率上升一碼」的說詞，請問「一碼」是多少？", "options": {"A": "0.01%", "B": "0.125%", "C": "0.25%", "D": "0.5%"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-365", "stem": "國庫券之發行、買回及還本付息等業務，係委由下列何者經理？", "options": {"A": "財政部", "B": "中央銀行", "C": "臺灣銀行", "D": "商業銀行"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-366", "stem": "國庫券的競標者，其投標利率低於底標利率時，下列敘述何者正確？", "options": {"A": "由低至高依次得標", "B": "由高至低依次得標", "C": "由投標時間先後依次得標", "D": "由投標金額大小依次得標"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-367", "stem": "國庫券的非競標者，其申購價格係按下列何者計算？", "options": {"A": "競標發行價格", "B": "競標最低價格", "C": "競標最高價格", "D": "競標最高價與最低價之平均價"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-368", "stem": "銀行發行可轉讓定期存單可按月發行或指定到期日，其最低天期為何？", "options": {"A": "七天", "B": "十四天", "C": "二十一天", "D": "一個月"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-369", "stem": "銀行為資金調度需要，發行可轉讓定期存單，其發行天期最長為多久？", "options": {"A": "六個月", "B": "一年", "C": "二年", "D": "三年"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-370", "stem": "金融機構經營拆款業務所得之利息收入，應繳納多少營業稅？", "options": {"A": "5%", "B": "20%", "C": "25%", "D": "免徵"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-371", "stem": "目前拆款市場的交割清算，大多採用下列何種方式辦理？", "options": {"A": "央行支票", "B": "央行同資系統", "C": "財金網路系統", "D": "ATM 轉帳"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-372", "stem": "下列何者不得作為流動準備？", "options": {"A": "超額準備", "B": "金融業互拆借差", "C": "國庫券", "D": "股票"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-373", "stem": "下列何者非屬金融機構合併法所定義之銀行業？", "options": {"A": "證券金融事業", "B": "信用合作社", "C": "票券金融公司", "D": "信用卡業務機構"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-374", "stem": "下列何者於購買短期票券時，其利息收入免予扣繳所得稅？", "options": {"A": "教育機構", "B": "個人", "C": "上市公司", "D": "合夥事業"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-375", "stem": "下列何者非屬中央銀行執行貨幣政策的工具？", "options": {"A": "公開市場操作", "B": "重貼現率政策", "C": "存款準備率政策", "D": "調整稅率政策"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-376", "stem": "下列何者為我國中央銀行作為經常性信用控管的一項政策工具，其在執行貨幣政策時，較具時效性、機動性及主動性？", "options": {"A": "公開市場操作", "B": "重貼現率政策", "C": "存款準備率政策", "D": "財政政策"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-377", "stem": "中央銀行如欲採取寬鬆貨幣政策，則應採取下列何項措施？", "options": {"A": "提高存款準備率", "B": "提高重貼現率", "C": "買進可轉讓定存單", "D": "賣出可轉讓定存單"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-378", "stem": "下列何者係中央銀行實施公開市場操作的短期目標？", "options": {"A": "影響貨幣數量及利率水準", "B": "實現穩定物價", "C": "經濟成長", "D": "充分就業"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-379", "stem": "依票券金融管理法規定，融資性商業本票之發行，需委由經信用評等機構評等之金融機構保證，下列何者非屬前述所稱之金融機構？", "options": {"A": "銀行", "B": "投顧公司", "C": "信託投資公司", "D": "票券金融公司"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-380", "stem": "下列何者非屬票券商辦理簽證作業之內容？", "options": {"A": "核驗發行人簽章", "B": "核驗保證人簽章", "C": "核驗票面額、發行日及到期日", "D": "洽定交易條件"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-381", "stem": "發行人所發行之商業本票，票券商承諾全數買入，並於承銷當日給付價款的方式，稱之為下列何者？", "options": {"A": "包銷", "B": "代銷", "C": "寄售", "D": "委辦"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-382", "stem": "中央銀行可轉讓定期存單之發行面額分為三種，下列何者非屬之？", "options": {"A": "新台幣一百萬元", "B": "新台幣五百萬元", "C": "新台幣一千萬元", "D": "新台幣一億元"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-383", "stem": "發行人運用融資性商業本票籌集資金，其需經過之程序，下列何者錯誤？", "options": {"A": "保證", "B": "簽證", "C": "承銷", "D": "兌償"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-384", "stem": "「損失的不確定性」指的是下列何者?", "options": {"A": "風險", "B": "風險因素", "C": "風險事故", "D": "風險標的"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-385", "stem": "人的健康狀況屬於下列那一個名詞？", "options": {"A": "風險標的", "B": "風險程度", "C": "風險因素", "D": "風險事故"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-386", "stem": "下列何者敍述不正確？", "options": {"A": "風險事故會影響風險因素", "B": "風險因素會影響損失幅度", "C": "風險事故為造成損失的意外事故", "D": "損失指非自願性的經濟價值減少"}, "answer": "A"}
{"id": "finance_ethics-金融市場常識-387", "stem": "下列何者屬於純粹風險？", "options": {"A": "外匯風險", "B": "生產風險", "C": "信用風險", "D": "政治風險"}, "answer": "C"}
