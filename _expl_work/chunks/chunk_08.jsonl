{"id": "finance_ethics-金融市場常識-395", "stem": "保險所承保的風險，一般僅限於：", "options": {"A": "動態風險", "B": "純粹風險", "C": "投機風險", "D": "基本風險"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-396", "stem": "下列何者為可保風險？", "options": {"A": "創新風險", "B": "行銷風險", "C": "財產風險", "D": "生產風險"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-397", "stem": "下列何者不是可保風險之要件?", "options": {"A": "損失機率須可以預測", "B": "損失須為明確且可衡量", "C": "須有大量異質性風險單位", "D": "須有釀成個別經濟單位重大損失之可能"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-398", "stem": "保險契約的當事人為：", "options": {"A": "被保險人與要保人", "B": "被保險人與保險人", "C": "要保人與保險人", "D": "要保人與受益人"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-399", "stem": "在保險事故發生時，保險人支付給被保險人或受益人的補償金額稱為：", "options": {"A": "保險金額", "B": "保險價額", "C": "保險費", "D": "保險金"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-400", "stem": "保險契約的關係人指：", "options": {"A": "保險人與被保險人", "B": "被保險人與受益人", "C": "要保人與受益人", "D": "要保人與被保險人"}, "answer": "B"}
{"id": "finance_ethics-金融市場常識-401", "stem": "我國保險法將保險分為：", "options": {"A": "財產保險與人壽保險", "B": "產物保險與人壽保險", "C": "財產保險與人身保險", "D": "產物保險與人身保險"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-402", "stem": "一般人壽保險屬於：", "options": {"A": "費用保險", "B": "損害保險", "C": "定值保險", "D": "定額保險"}, "answer": "D"}
{"id": "finance_ethics-金融市場常識-403", "stem": "下列何者不屬於人壽保險之性質？", "options": {"A": "保險期間長", "B": "多屬個人保險", "C": "保險價額高", "D": "屬定額保險"}, "answer": "C"}
{"id": "finance_ethics-金融市場常識-404", "stem": "產險公司不得經營下列何種保險？", "options": {"A": "年金保險", "B": "健康保險", "C": "傷害保險", "D": "旅行平安保險"}, "answer": "A"}
